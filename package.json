{
  "name": "react-router-lint-routes",
  "version": "1.1.0",
  "description": "Lint route paths to enforce type-safe href() usage in React Router 7 projects",
  "keywords": [
    "react-router",
    "lint",
    "href",
    "type-safe"
  ],
  "license": "MIT",
  "author": "Christoph Gockel",
  "type": "module",
  "bin": {
    "react-router-lint-routes": "main.ts"
  },
  "files": [
    "src/",
    "LICENSE",
    "main.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci --error-on-warnings",
    "start": "node main.ts",
    "test": "vitest",
    "typecheck": "tsc",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^24.13.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react-router": ">=7.0.0",
    "typescript": ">=5.8.0"
  }
}
